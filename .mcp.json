{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "maestro": {
      "command": "maestro",
      "args": ["mcp"]
    },
    "expo": {
      "type": "http",
      "url": "https://mcp.expo.dev/mcp",
      "headers": {}
    },
    "wigolo": {
      "command": "npx",
      "args": ["-y", "wigolo"],
      "envFile": "${userHome}/.wigolo/.env"
    },
    "contentful": {
      "type": "http",
      "url": "https://mcp.contentful.com/mcp"
    },
    "heroui-native": {
      "command": "bunx",
      "args": ["@heroui/native-mcp@latest"]
    }
  }
}
